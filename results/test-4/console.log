sandbox_path = '/var/folders/hx/y1zj_dgn34j4tzlyw_27wqzr0000gn/T/statagent-local-fupstre_/Perceived_stress_and_patient_satisfaction_among_adults_using_telemedicine_follow-up_clinics_simulated.csv'

df = pd.read_csv(sandbox_path)

# Clean column names: strip whitespace
orig_cols = list(df.columns)
new_cols = [c.strip() for c in orig_cols]
rename_map = dict(zip(orig_cols, new_cols))
df = df.rename(columns=rename_map)
print(df.columns.tolist())

# Attach dataframe to the sandbox (persisted variable 'df')
# Print first rows of the scored columns added by score_items_tool
print('\nScored columns present:')
for c in ['Patient_satisfaction_score', 'PSS10_score', 'PSQI_score']:
    print(c, c in df.columns)

# Show descriptive stats for these scores
print('\nScore summary:')
print(df[['Patient_satisfaction_score','PSS10_score','PSQI_score']].describe(include='all'))

# Check distributions for normality tests later
from scipy.stats import shapiro

norm_results = {}
for col in ['Patient_satisfaction_score','PSS10_score','PSQI_score']:
    # shapiro requires finite values and n between 3 and 5000
    vals = df[col].dropna()
    if len(vals) >= 3:
        stat, p = shapiro(vals)
        norm_results[col] = {'stat': stat, 'p': p, 'n': len(vals)}
    else:
        norm_results[col] = None

print('\nShapiro results:')
print(norm_results)

# Spearman correlations between scores
from scipy.stats import spearmanr
pairwise = {}
for a in ['Patient_satisfaction_score','PSS10_score','PSQI_score']:
    for b in ['Patient_satisfaction_score','PSS10_score','PSQI_score']:
        if a < b:
            r, p = spearmanr(df[a], df[b], nan_policy='omit')
            pairwise[f'{a}_vs_{b}'] = {'rho': r, 'p': p}

print('\nSpearman correlations:')
print(pairwise)

# Prepare demographic columns for tests
# Create short column names consistent with study_plan variables
df = df.rename(columns={
    'What is your age in completed years?': 'AGE',
    'What is your sex?': 'SEX',
    'What is the highest level of education you have completed?': 'EDUCATION',
    'Have you been diagnosed with any long-term medical condition?': 'COMORBIDITY'
})
print('\nRenamed demographic columns:', ['AGE','SEX','EDUCATION','COMORBIDITY'])

# Compare Patient_satisfaction_score by SEX (two groups)
from scipy.stats import mannwhitneyu
male = df.loc[df['SEX']=='Male','Patient_satisfaction_score'].dropna()
female = df.loc[df['SEX']=='Female','Patient_satisfaction_score'].dropna()

mw_stat, mw_p = mannwhitneyu(male, female, alternative='two-sided')
print('\nMann-Whitney U test (Patient_satisfaction by SEX): stat, p')
print(mw_stat, mw_p)

# ANOVA (or Kruskal) across EDUCATION (multiple groups)
groups = [g.dropna() for _,g in df.groupby('EDUCATION')['Patient_satisfaction_score']]
from scipy.stats import kruskal
kw_stat, kw_p = kruskal(*groups)
print('\nKruskal-Wallis (Patient_satisfaction by EDUCATION): stat, p')
print(kw_stat, kw_p)

# Compare Patient_satisfaction by COMORBIDITY (Yes/No)
yes = df.loc[df['COMORBIDITY']=='Yes','Patient_satisfaction_score'].dropna()
no = df.loc[df['COMORBIDITY']=='No','Patient_satisfaction_score'].dropna()
kw2_stat, kw2_p = mannwhitneyu(yes, no, alternative='two-sided')
print('\nMann-Whitney U (Patient_satisfaction by COMORBIDITY): stat, p')
print(kw2_stat, kw2_p)

# Multivariable linear regression: outcome Patient_satisfaction_score
import statsmodels.formula.api as smf
# Need to create numeric covariates where appropriate; use AGE, SEX, EDUCATION, COMORBIDITY, PSS10_score, PSQI_score
# Create dummy variables for SEX, EDUCATION, COMORBIDITY
model_df = df[['Patient_satisfaction_score','PSS10_score','PSQI_score','AGE','SEX','EDUCATION','COMORBIDITY']].copy()
model_df = pd.get_dummies(model_df, columns=['SEX','EDUCATION','COMORBIDITY'], drop_first=True)
# Build formula programmatically
outcome = 'Patient_satisfaction_score'
predictors = [c for c in model_df.columns if c!=outcome]
formula = outcome + ' ~ ' + ' + '.join(predictors)
print('\nRegression formula:')
print(formula)

lm = smf.ols(formula, data=model_df, missing='drop').fit()
print('\nRegression summary (first lines):')
print(lm.summary().tables[0])
print(lm.summary().tables[1])

# Save key outputs to a dict to return
results = {
    'shapiro': norm_results,
    'spearman': pairwise,
    'mw_sex': {'stat': mw_stat, 'p': mw_p, 'n_male': len(male), 'n_female': len(female)},
    'kw_education': {'stat': kw_stat, 'p': kw_p},
    'mw_comorbidity': {'stat': kw2_stat, 'p': kw2_p, 'n_yes': len(yes), 'n_no': len(no)},
    'regression_summary': lm.summary().as_text()
}

print('\nPrepared results dict keys:')
print(list(results.keys()))

results
