# Reuse df already in the sandbox
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

# Copy df
mdf = df.copy()
# Rename score and demographic columns to short safe names
mdf = mdf.rename(columns={
    'Patient_satisfaction_score': 'psq_score',
    'PSS10_score': 'pss_score',
    'PSQI_score': 'psqi_score',
    'AGE': 'age',
    'SEX': 'sex',
    'EDUCATION': 'education',
    'COMORBIDITY': 'comorbidity'
})

# Create dummies for categorical predictors, drop first to avoid multicollinearity
mdf = pd.get_dummies(mdf, columns=['sex','education','comorbidity'], drop_first=True)

# Sanitize column names to valid Python identifiers: replace non-word chars with underscore
mdf.columns = [pd.io.parsers.ParserBase({'names':[]})._maybe_dedup_name(c).replace(' ', '_') if isinstance(c,str) else c for c in mdf.columns]
# A safer approach to sanitize: replace non-alphanumeric with underscore
import re
mdf.columns = [re.sub(r'\W+', '_', str(c)) for c in mdf.columns]

# Ensure outcome present
print('psq_score in columns?', 'psq_score' in mdf.columns)

# Build formula: psq_score ~ pss_score + psqi_score + age + all dummy cols except outcome
outcome = 'psq_score'
predictors = [c for c in mdf.columns if c!=outcome and not c.startswith('Timestamp') and not c.startswith('Do_you_consent')]
# Remove original free-text columns accidentally included
# Keep only numeric predictors
predictors = [c for c in predictors if pd.api.types.is_numeric_dtype(mdf[c])]
formula = outcome + ' ~ ' + ' + '.join(predictors)
print('Formula length, predictors count:', len(predictors))

# Fit OLS
model = smf.ols(formula, data=mdf, missing='drop').fit()

# Extract coefficients, pvalues, R-squared, N
coefs = model.params.to_dict()
pvals = model.pvalues.to_dict()
rsq = model.rsquared
nobs = int(model.nobs)

print('Regression fitted. N, R-squared: ', nobs, rsq)

# Prepare a concise summary dict with coefficient, std err, t, p for each predictor
summary = {}
for var in model.params.index:
    summary[var] = {'coef': float(model.params[var]), 'std_err': float(model.bse[var]), 't': float(model.tvalues[var]), 'p': float(model.pvalues[var])}

results = {'nobs': nobs, 'rsquared': float(rsq), 'summary': summary}
results
