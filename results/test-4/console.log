    code: # Minimal checks and tests using existing `df` in sandbox
print('Confirming columns present:')
print(df.columns.tolist())

from scipy.stats import shapiro, spearmanr, mannwhitneyu, kruskal

out = {}
# Shapiro for overall scores
for col in ['Patient_satisfaction_score','PSS10_score','PSQI_score']:
    vals = df[col].dropna()
    if len(vals) >= 3:
        stat, p = shapiro(vals)
        out[col] = {'stat': float(stat), 'p': float(p), 'n': int(len(vals))}
    else:
        out[col] = None

# Shapiro by SEX groups
sex_shapiro = {}
for g in df['SEX'].unique():
    vals = df.loc[df['SEX']==g,'Patient_satisfaction_score'].dropna()
    if len(vals) >= 3:
        s,p = shapiro(vals)
        sex_shapiro[g] = {'stat': float(s), 'p': float(p), 'n': int(len(vals))}
    else:
        sex_shapiro[g] = None

# Spearman correlations between scores
spearman = {}
pairs = [('Patient_satisfaction_score','PSS10_score'),('Patient_satisfaction_score','PSQI_score'),('PSS10_score','PSQI_score')]
for a,b in pairs:
    r,p = spearmanr(df[a], df[b], nan_policy='omit')
    spearman[f'{a}_vs_{b}'] = {'rho': float(r), 'p': float(p)}

# Mann-Whitney U for satisfaction by SEX
male = df.loc[df['SEX']=='Male','Patient_satisfaction_score'].dropna()
female = df.loc[df['SEX']=='Female','Patient_satisfaction_score'].dropna()
if len(male)>=3 and len(female)>=3:
    mw_stat, mw_p = mannwhitneyu(male, female, alternative='two-sided')
    mw = {'stat': float(mw_stat), 'p': float(mw_p), 'n_male': int(len(male)), 'n_female': int(len(female))}
else:
    mw = None

# Kruskal across EDUCATION groups
groups = [g.dropna() for _,g in df.groupby('EDUCATION')['Patient_satisfaction_score']]
if len(groups) >= 2:
    kw_stat, kw_p = kruskal(*groups)
    kw = {'stat': float(kw_stat), 'p': float(kw_p)}
else:
    kw = None

out_all = {'shapiro_overall': out, 'shapiro_by_sex': sex_shapiro, 'spearman': spearman, 'mw_sex': mw, 'kw_education': kw}
print('\nResults prepared')
out_all
